# Which GenLayer network the app talks to: studiodev | studionet | bradbury
#
# studiodev (chain 61997) is the only one running the v0.3.0 executor line this
# contract targets. The same source deployed to studionet or bradbury answers
# `invalid_contract runner malformed` — a runner-version mismatch, not a bug.
NEXT_PUBLIC_NETWORK=studiodev

# The deployed StakeYourWord address on that network.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional. Where app/api/rpc relays to. Defaults to the endpoint for
# NEXT_PUBLIC_NETWORK, so it cannot drift from the chain the client talks to.
# Deliberately NOT NEXT_PUBLIC_: the browser must go through the relay, not around it.
# GENLAYER_RPC_UPSTREAM=https://studio-dev.genlayer.com/api

# Optional. Extra browser origins allowed to call the relay, comma-separated.
# RPC_PROXY_ALLOWED_ORIGINS=https://example.com
